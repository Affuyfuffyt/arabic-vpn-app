<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@color/bg_card_alt">

    <!-- الصف العلوي: الوقت + النوع -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_log_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:fontFamily="monospace"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tv_log_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- الرمز -->
    <TextView
        android:id="@+id/tv_log_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp" />

    <!-- وين -->
    <TextView
        android:id="@+id/tv_log_where"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="2dp" />

    <!-- ليش -->
    <TextView
        android:id="@+id/tv_log_why"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="2dp" />

    <!-- السبب -->
    <TextView
        android:id="@+id/tv_log_cause"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

</LinearLayout>
